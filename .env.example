# Copia este archivo a .env y rellena los valores reales.
# .env NUNCA se sube al repo (está en .gitignore).

# --- NCSA (acceso vía login web con Selenium, no hay API pública) ---
NCSA_EMAIL=tu_correo@ejemplo.com
NCSA_PASSWORD=tu_password

# --- WHOOP (API no oficial, OAuth2) ---
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REFRESH_TOKEN=

# --- Gmail ---
# El flujo OAuth usa gmail_credentials.json (descargado de Google Cloud Console).
# Este es solo el correo de la cuenta que recibe mensajes de coaches.
GMAIL_CUENTA_COACHES=coaches.gael@gmail.com

# --- Selenium ---
# Ruta al ChromeDriver (misma versión que tu Chrome).
# https://googlechromelabs.github.io/chrome-for-testing/
CHROMEDRIVER_PATH=/usr/local/bin/chromedriver
CHROME_HEADLESS=false

# --- Envios (carpeta envios/) ---
# Clave para abrir el túnel de envios temporales.
TUNEL_CLAVE=
# Correos de los destinatarios (para compartir archivos definitivos en Drive).
EMAIL_GAEL=
EMAIL_KARLA=
# Handles de iMessage — se envia a cada destinatario POR SEPARADO (telefono o Apple ID).
IMESSAGE_GAEL=
IMESSAGE_KARLA=
# ID de la carpeta de Drive para archivos definitivos ("Generados x Claude").
DRIVE_CARPETA_ID=
# (Opcional) Comando para abrir el tunel temporal. Plantilla con {archivo} y {clave};
# debe imprimir la URL del tunel. Ej: cloudflared/localtunnel/tu script.
TUNEL_CMD=
# (Opcional) Comando para subir a Drive. Plantilla con {archivo} y {carpeta};
# debe imprimir el enlace de Drive. Ej: rclone + rclone link, o tu script.
DRIVE_SUBIR_CMD=
